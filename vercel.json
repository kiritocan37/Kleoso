{
  "headers": [
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|webp|ico|svg|woff2|woff|js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(index\\.html|sitemap\\.xml|robots\\.txt|manifest\\.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
